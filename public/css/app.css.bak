/* ===================================================================
   میدان — سیستم طراحی مشترک (پابلیک + پنل‌ها)
   =================================================================== */

/* فونت‌های اختصاصی میدان — PROGO برای عناوین/اعداد درشت (شخصیت بصری برند)،
   KookFaNum برای متن بدنه و رابط کاربری. Vazirmatn (وب‌فونت گوگل) به‌عنوان
   fallback برای گلیف‌هایی که این دو فونت پوشش نمی‌دن (مثل لاتین) نگه داشته می‌شه. */
@font-face{
  font-family:'PROGO';
  src:url('../fonts/PROGO_Regular.otf') format('opentype');
  font-weight:400;
  font-style:normal;
  font-display:swap;
}
@font-face{
  font-family:'KookFaNum';
  src:url('../fonts/KookFaNum-Medium.ttf') format('truetype');
  font-weight:500;
  font-style:normal;
  font-display:swap;
}

:root{
  --bg:#F3EEE1;
  --ink:#1E2A22;
  --ink-soft:#54604F;
  --primary:#0E4B3B;
  --primary-dark:#0A3529;
  --primary-tint:#E3EAE3;
  --accent:#C08A2E;
  --accent-tint:#F5E9CE;
  --surface:#FFFFFF;
  --border:#E1D9C4;
  --radius:14px;
  --red:#B04A3A;
  --red-tint:#F5E1DC;
  --blue:#2E5FA3;
  --blue-tint:#E1EAF5;
  --green:#2E8B57;
  --green-tint:#E5F3EA;
  --font-body:'Inter','KookFaNum','Vazirmatn',sans-serif;
  --font-display:'Inter','PROGO','Vazirmatn',sans-serif;
  --ease:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font-body); background:var(--bg); color:var(--ink); line-height:1.7; font-size:14px;}
a{color:inherit; text-decoration:none;}
img{display:block; max-width:100%;}
.wrap{max-width:1180px; margin:0 auto; padding:0 32px;}
@media(max-width:768px){ .wrap{padding:0 20px;} }
@media(max-width:480px){ .wrap{padding:0 16px;} }

h1,h2,h3,h4,
.logo, .foot-logo, .side-logo, .auth-logo,
.booth-id h1, .topbar h1,
.section-head h2, .booth-body h3, .prod-body h4{
  font-family:var(--font-display);
  font-weight:400;
}

a, button, .btn, .chip, .cat-item, .booth-card, .pg-item, .icon-btn,
.side-link, .navlinks a, .foot-col a, input.field, select.field, textarea.field,
.media-img, .cat-icon, .filter-opt, .tab{
  transition:transform .25s var(--ease), box-shadow .25s var(--ease), background-color .2s ease, border-color .2s ease, color .2s ease, opacity .2s ease;
}

a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible{
  outline:2px solid var(--accent); outline-offset:2px; border-radius:4px;
}

/* ---------- BUTTONS ---------- */
.btn{display:inline-flex; align-items:center; gap:6px; padding:11px 22px; border-radius:10px; font-size:14px; font-weight:600; border:1px solid transparent; cursor:pointer; font-family:inherit;}
.btn-primary{background:var(--primary); color:#fff;}
.btn-primary:hover{background:var(--primary-dark); transform:translateY(-2px); box-shadow:0 10px 22px rgba(14,75,59,.24);}
.btn-ghost{border-color:var(--primary); color:var(--primary); background:transparent;}
.btn-ghost:hover{background:var(--primary); color:#fff; transform:translateY(-2px); box-shadow:0 10px 22px rgba(14,75,59,.16);}
.btn-sm{padding:8px 16px; font-size:13px;}
.btn-danger{background:var(--red); color:#fff;}
.btn-danger:hover{background:#8f3b2e; transform:translateY(-2px); box-shadow:0 10px 22px rgba(176,74,58,.24);}
.btn:active{transform:translateY(0); box-shadow:none;}

/* ---------- PUBLIC HEADER ---------- */
header.site{position:sticky; top:0; z-index:50; background:rgba(243,238,225,0.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--border); transition:box-shadow .3s ease;}
.nav{display:flex; align-items:center; justify-content:space-between; height:76px; gap:16px;}
.logo{display:flex; align-items:center; gap:10px; font-size:22px; font-weight:400; color:var(--primary); flex-shrink:0;}
.logo-mark{width:34px; height:34px; border-radius:9px; background:var(--primary); position:relative; flex-shrink:0; transition:transform .3s var(--ease), border-radius .3s var(--ease);}
.logo:hover .logo-mark{transform:rotate(-8deg) scale(1.06); border-radius:11px;}
.logo-mark::before,.logo-mark::after{content:""; position:absolute; background:var(--accent); border-radius:2px;}
.logo-mark::before{width:14px; height:4px; top:10px; right:10px;}
.logo-mark::after{width:8px; height:4px; bottom:10px; right:10px;}
.navlinks{display:flex; gap:36px; font-size:15px; font-weight:500; color:var(--ink-soft);}
.navlinks a{position:relative; padding-bottom:5px;}
.navlinks a::after{content:""; position:absolute; right:0; left:0; bottom:0; height:2px; background:var(--primary); border-radius:2px; transform:scaleX(0); transition:transform .3s var(--ease);}
.navlinks a:hover{color:var(--primary);}
.navlinks a:hover::after, .navlinks a.on::after{transform:scaleX(1);}
.navlinks a.on{color:var(--primary); font-weight:700;}
.navright{display:flex; align-items:center; gap:18px;}
.lang-toggle{display:flex; border:1px solid var(--border); border-radius:20px; overflow:hidden; font-size:13px; font-weight:600; flex-shrink:0;}
.lang-toggle span{padding:6px 14px; display:block; transition:background-color .25s ease, color .25s ease;}
.lang-toggle .active{background:var(--primary); color:#fff;}
.lang-toggle .inactive{color:var(--ink-soft);}
.lang-toggle a:hover .inactive{color:var(--primary);}

/* ---------- MOBILE NAV TOGGLE ---------- */
.nav-toggle{
  display:none; align-items:center; justify-content:center; width:40px; height:40px;
  border:1px solid var(--border); border-radius:10px; background:var(--surface); cursor:pointer;
  flex-shrink:0; padding:0;
}
.nav-toggle svg{width:19px; height:19px; stroke:var(--ink); fill:none; stroke-width:1.8;}
.nav-scrim{display:none;}

@media(max-width:960px){
  .nav-toggle{display:flex;}
  .navlinks{
    position:fixed; inset:76px 0 0 auto; top:76px; width:min(78vw,320px); height:calc(100vh - 76px);
    background:var(--surface); flex-direction:column; align-items:flex-start; gap:2px; padding:18px;
    box-shadow:-16px 0 40px rgba(10,53,41,.14); transform:translateX(100%); transition:transform .32s var(--ease);
    overflow-y:auto; z-index:60;
  }
  html[dir="ltr"] .navlinks{ right:auto; left:0; transform:translateX(-100%); box-shadow:16px 0 40px rgba(10,53,41,.14); }
  .navlinks a{padding:13px 10px; width:100%; border-radius:10px;}
  .navlinks a:hover{background:var(--primary-tint);}
  .navlinks a::after{display:none;}
  body.nav-open .navlinks{transform:translateX(0);}

  .navright{
    position:fixed; right:0; left:auto; top:76px; width:min(78vw,320px); z-index:60;
    flex-direction:column; align-items:stretch; gap:10px; padding:0 18px 18px;
    height:0; overflow:hidden; background:var(--surface); box-shadow:-16px 0 40px rgba(10,53,41,.14);
    transition:height .32s var(--ease);
  }
  html[dir="ltr"] .navright{ right:auto; left:0; box-shadow:16px 0 40px rgba(10,53,41,.14); }
  body.nav-open .navright{height:auto; padding-top:14px; border-top:1px solid var(--border);}
  .navright .lang-toggle{align-self:flex-start;}
  .navright > a:not(.btn){align-self:flex-start;}
  .navright form{width:100%;}
  .navright .btn{width:100%; justify-content:center;}

  .nav-scrim{
    display:block; content:""; position:fixed; inset:76px 0 0 0; background:rgba(10,53,41,.35);
    opacity:0; pointer-events:none; transition:opacity .3s ease; z-index:55;
  }
  body.nav-open .nav-scrim{opacity:1; pointer-events:auto;}
  body.nav-open{overflow:hidden;}
}

/* ---------- FOOTER ---------- */
footer.site{background:var(--primary-dark); color:#CFE0D6; padding:56px 0 28px; margin-top:60px;}
.foot-grid{display:grid; grid-template-columns:1.4fr repeat(3,1fr); gap:40px; margin-bottom:44px;}
.foot-logo{color:#fff; font-size:20px; font-weight:400; margin-bottom:14px;}
.foot-col h5{color:#fff; font-size:13px; font-weight:700; margin-bottom:16px;}
.foot-col a{display:block; font-size:13.5px; margin-bottom:11px; color:#B9CDBF; position:relative; width:fit-content;}
.foot-col a:hover{color:#fff; transform:translateX(-4px);}
.foot-bottom{border-top:1px solid rgba(255,255,255,0.1); padding-top:22px; display:flex; justify-content:space-between; font-size:12.5px; color:#8FA898; flex-wrap:wrap; gap:8px;}
@media(max-width:820px){
  .foot-grid{grid-template-columns:1fr 1fr; gap:30px 24px;}
}
@media(max-width:560px){
  footer.site{padding:44px 0 24px;}
  .foot-grid{grid-template-columns:1fr; gap:30px;}
  .foot-bottom{flex-direction:column; text-align:center;}
}

/* ---------- ALERTS ---------- */
.alert{border-radius:10px; padding:13px 18px; font-size:13.5px; margin-bottom:20px;}
.alert-success{background:var(--green-tint); color:var(--green);}
.alert-error{background:var(--red-tint); color:var(--red);}

/* ---------- BREADCRUMB ---------- */
.crumb{padding:22px 0 0; font-size:13px; color:var(--ink-soft);}
.crumb .sep{margin:0 8px; color:var(--border);}
.crumb a:hover{color:var(--primary);}

/* ---------- PRODUCT DETAIL ---------- */
.product-detail-grid{display:grid; grid-template-columns:1fr 1fr; gap:44px; padding:30px 0 70px;}
.product-detail-img{width:100%; height:420px; object-fit:cover; border-radius:var(--radius); background:var(--primary-tint);}
@media(max-width:820px){
  .product-detail-grid{grid-template-columns:1fr; gap:28px; padding:24px 0 50px;}
  .product-detail-img{height:320px;}
}
@media(max-width:480px){
  .product-detail-img{height:240px;}
}

/* ---------- SECTION HEAD ---------- */
.section{padding:70px 0;}
.section-head{display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:34px;}
.section-head h2{font-size:28px; font-weight:400; color:var(--primary-dark);}
.section-head p{color:var(--ink-soft); font-size:14px; margin-top:6px;}
.more-link{font-size:14px; font-weight:600; color:var(--primary); white-space:nowrap; display:inline-block;}
.more-link:hover{transform:translateX(-4px);}


/* ---------- HOME HERO ---------- */
.hero-home{padding:38px 0 46px; position:relative; overflow:hidden;}
.hero-home::before{
  content:""; position:absolute; inset:0; background:
    radial-gradient(circle at top right, rgba(192,138,46,.16), transparent 28%),
    radial-gradient(circle at bottom left, rgba(14,75,59,.14), transparent 28%);
  pointer-events:none;
}
.hero-shell{display:grid; grid-template-columns:1.02fr .98fr; gap:34px; align-items:center; position:relative; z-index:1;}
.hero-copy{background:linear-gradient(180deg, rgba(255,255,255,.82), rgba(255,255,255,.72)); border:1px solid rgba(225,217,196,.85); border-radius:30px; padding:34px; box-shadow:0 20px 45px rgba(10,53,41,.08); backdrop-filter:blur(10px);}
.hero-kicker{display:inline-flex; align-items:center; gap:8px; color:var(--accent); font-weight:700; font-size:14px; margin-bottom:16px;}
.hero-kicker::before{content:""; width:8px; height:8px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 8px rgba(192,138,46,.13);}
.hero-copy h1{font-size:42px; line-height:1.35; color:var(--primary-dark); margin-bottom:18px;}
.hero-copy p{font-size:16px; color:var(--ink-soft); max-width:560px; margin-bottom:24px;}
.hero-search{display:flex; align-items:center; gap:10px; background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:8px; max-width:520px; box-shadow:0 10px 28px rgba(10,53,41,.06);}
.hero-search input{flex:1; border:none; outline:none; background:transparent; font-family:inherit; font-size:14px; padding:12px 14px; color:var(--ink);}
.hero-search button{background:linear-gradient(135deg, var(--accent), #d39d43); color:#fff; border:none; border-radius:12px; padding:12px 22px; font-family:inherit; font-weight:700; font-size:14px; cursor:pointer; box-shadow:0 10px 20px rgba(192,138,46,.2);}
.hero-search button:hover{transform:translateY(-2px);}
.hero-actions{display:flex; flex-wrap:wrap; gap:12px; margin:20px 0 26px;}
.hero-mini-stats{display:grid; grid-template-columns:repeat(3,1fr); gap:14px;}
.hero-mini-card{background:rgba(255,255,255,.9); border:1px solid rgba(225,217,196,.95); border-radius:18px; padding:14px 16px; box-shadow:0 10px 26px rgba(10,53,41,.05);}
.hero-mini-card strong{display:block; font-family:var(--font-body); font-weight:700; font-size:22px; color:var(--primary-dark); margin-bottom:3px;}
.hero-mini-card span{font-size:12px; color:var(--ink-soft);}
.hero-visual{position:relative; min-height:500px;}
.hero-mosaic{display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(3,116px); gap:14px;}
.hero-tile{position:relative; border-radius:24px; overflow:hidden; min-height:110px; box-shadow:0 18px 38px rgba(10,53,41,.12); isolation:isolate;}
.hero-tile img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .65s var(--ease), filter .3s ease;}
.hero-tile-overlay{position:absolute; inset:0; background:linear-gradient(180deg, rgba(10,53,41,.10) 0%, rgba(10,53,41,.72) 100%);}
.hero-tile-content{position:absolute; inset:auto 16px 16px 16px; color:#fff; z-index:1; display:flex; flex-direction:column; gap:4px;}
.hero-tile-icon{width:38px; height:38px; border-radius:12px; background:rgba(255,255,255,.16); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; margin-bottom:6px; font-size:18px;}
.hero-tile strong{font-size:18px; line-height:1.35;}
.hero-tile small{font-size:12px; color:rgba(255,255,255,.82);}
.hero-tile:hover{transform:translateY(-8px) scale(1.01); box-shadow:0 28px 50px rgba(10,53,41,.16);}
.hero-tile:hover img{transform:scale(1.08); filter:saturate(1.08);}
.hero-tile-1{grid-column:1/3; grid-row:1/3;}
.hero-tile-2{grid-column:3/4; grid-row:1/2;}
.hero-tile-3{grid-column:3/4; grid-row:2/4;}
.hero-tile-4{grid-column:1/2; grid-row:3/4;}
.hero-tile-5{grid-column:2/3; grid-row:3/4;}
.hero-floating-card{position:absolute; left:24px; bottom:-16px; background:rgba(255,255,255,.92); border:1px solid rgba(225,217,196,.95); border-radius:20px; padding:16px 18px; box-shadow:0 20px 34px rgba(10,53,41,.12); max-width:280px; backdrop-filter:blur(10px);}
.hero-floating-card span{display:block; font-size:12px; color:var(--ink-soft); margin-bottom:6px;}
.hero-floating-card strong{display:block; font-size:18px; color:var(--primary-dark); margin-bottom:2px;}
.hero-floating-card small{font-size:12px; color:var(--accent);}
.hero-stats-band{padding:0 0 14px;}
.hero-stats-grid{display:grid; grid-template-columns:repeat(3,1fr); background:linear-gradient(135deg, var(--primary-dark), var(--primary)); color:#fff; border-radius:24px; padding:26px 10px; text-align:center; box-shadow:0 20px 40px rgba(10,53,41,.16);}
.hero-stats-grid b{display:block; font-family:var(--font-body); font-weight:700; font-size:28px; margin-bottom:4px;}
.hero-stats-grid span{font-size:13px; color:#cfe0d6;}

/* ---------- CHIPS / SUBCATS ---------- */
.subcats{display:flex; gap:10px; flex-wrap:wrap; padding-bottom:24px;}
.chip{padding:9px 18px; border-radius:20px; border:1px solid var(--border); background:var(--surface); font-size:13.5px; font-weight:600; color:var(--ink-soft); cursor:pointer; display:inline-block;}
.chip:hover{border-color:var(--primary); color:var(--primary); transform:translateY(-2px);}
.chip.on{background:var(--primary); border-color:var(--primary); color:#fff;}
.chip.on:hover{color:#fff;}

/* ---------- CATEGORY GRID ---------- */
.cat-rail{display:grid; grid-template-columns:repeat(6,1fr); gap:14px;}
.cat-item{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px 14px; text-align:center; display:block;}
.cat-item:hover{border-color:var(--primary); transform:translateY(-5px); box-shadow:0 14px 28px rgba(14,75,59,.1);}
.cat-icon{width:46px; height:46px; margin:0 auto 12px; border-radius:12px; background:var(--primary-tint); display:flex; align-items:center; justify-content:center; font-size:20px;}
.cat-item:hover .cat-icon{transform:scale(1.12) rotate(-6deg); background:var(--accent-tint);}
.cat-item b{display:block; font-size:14px; font-weight:600; margin-bottom:2px;}
.cat-item span{font-size:12px; color:var(--ink-soft);}

/* ---------- BOOTH / PRODUCT CARDS ---------- */
.booth-grid, .prod-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
.booth-card{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; display:block;}
.booth-card:hover{transform:translateY(-6px); box-shadow:0 18px 34px rgba(14,75,59,.14); border-color:var(--primary);}
.booth-media, .prod-media{height:140px; background:var(--primary-tint); position:relative; overflow:hidden;}
.media-img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .5s var(--ease);}
.booth-card:hover .media-img{transform:scale(1.09);}
.booth-badge, .prod-badge{position:absolute; top:12px; left:12px; background:var(--accent); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:20px;}
.booth-body, .prod-body{padding:16px;}
.booth-top{display:flex; align-items:center; gap:10px; margin-bottom:10px;}
.booth-logo, .cell-thumb, .approve-avatar{width:36px; height:36px; border-radius:10px; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; flex-shrink:0; overflow:hidden;}
.booth-logo img, .cell-thumb img, .approve-avatar img{width:100%; height:100%; object-fit:cover;}
.booth-body h3, .prod-body h4{font-size:14.5px; font-weight:400; margin-bottom:2px; transition:color .2s ease;}
.booth-card:hover .booth-body h3, .booth-card:hover .prod-body h4{color:var(--primary);}
.booth-body .cat{font-size:11.5px; color:var(--ink-soft);}
.booth-desc{font-size:12.5px; color:var(--ink-soft); margin-bottom:14px;}
.booth-foot{display:flex; align-items:center; justify-content:space-between; font-size:12px; border-top:1px solid var(--border); padding-top:11px;}
.booth-foot .pay{color:var(--primary); font-weight:600;}
.booth-foot .contact, .booth-foot .products{color:var(--ink-soft);}
.prod-price{font-family:var(--font-body); font-size:15.5px; font-weight:700; color:var(--primary-dark);}
.prod-price small{font-size:11px; font-weight:500; color:var(--ink-soft);}
.prod-price-row{display:flex; align-items:center; justify-content:space-between; margin-top:12px;}

/* ---------- FILTER SIDEBAR ---------- */
.layout{display:grid; grid-template-columns:250px 1fr; gap:36px;}
.layout-booth{grid-template-columns:1fr 260px; padding-bottom:80px;}
.checkout-grid{display:grid; grid-template-columns:1.5fr 1fr; gap:24px; align-items:flex-start;}
@media(max-width:760px){
  .layout-booth{padding-bottom:50px;}
  .checkout-grid{grid-template-columns:1fr;}
}
.filter-box{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px; margin-bottom:18px;}
.filter-box h4{font-size:14px; font-weight:700; margin-bottom:16px;}
.filter-opt{display:flex; align-items:center; gap:10px; font-size:13.5px; color:var(--ink-soft); margin-bottom:12px; cursor:pointer; border-radius:6px;}
.filter-opt:hover{color:var(--ink);}
.filter-opt input{accent-color:var(--primary); width:15px; height:15px;}
.filter-opt span.count{margin-right:auto; color:#9AA79B; font-size:12px;}

/* ---------- TOOLBAR / SORT ---------- */
.toolbar{display:flex; align-items:center; justify-content:space-between; margin-bottom:22px;}
.toolbar .result-txt{font-size:13.5px; color:var(--ink-soft);}
.sort select, select.field, input.field, textarea.field{border:1px solid var(--border); border-radius:8px; padding:9px 12px; font-family:inherit; font-size:13px; background:var(--surface); color:var(--ink); width:100%;}
.sort select:hover, select.field:hover, input.field:hover, textarea.field:hover{border-color:#c9bc9a;}
.sort select:focus, select.field:focus, input.field:focus, textarea.field:focus{outline:none; border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-tint);}

/* ---------- PAGINATION ---------- */
.pagination{display:flex; justify-content:center; gap:8px; margin-top:40px;}
.pg-item{width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:9px; border:1px solid var(--border); background:var(--surface); font-size:13px; font-weight:600; color:var(--ink-soft);}
.pg-item:hover{border-color:var(--primary); color:var(--primary); transform:translateY(-2px); box-shadow:0 6px 14px rgba(14,75,59,.1);}
.pg-item.on{background:var(--primary); color:#fff; border-color:var(--primary);}
.pg-item.on:hover{color:#fff; transform:none;}

/* ---------- BOOTH PAGE BANNER ---------- */
.booth-banner{
  margin-top:20px; border-radius:20px; overflow:hidden; position:relative;
  background:linear-gradient(120deg, var(--primary) 0%, #16624c 60%, var(--primary-dark) 100%);
  height:210px; box-shadow:0 16px 34px rgba(10,53,41,.2);
}
.booth-banner img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}
.booth-banner::after{
  content:""; position:absolute; inset:0;
  background:linear-gradient(to top, rgba(8,42,33,.88) 0%, rgba(8,42,33,.42) 48%, rgba(8,42,33,.08) 78%);
}
.booth-banner-actions{position:absolute; top:16px; left:16px; z-index:3; display:flex; gap:10px;}
.booth-banner-content{
  position:absolute; right:24px; left:24px; bottom:20px; z-index:3;
  color:#fff; display:flex; flex-direction:column; gap:8px; align-items:flex-start;
}
.booth-banner-kicker{
  display:inline-flex; align-items:center; gap:6px; padding:7px 12px; border-radius:999px;
  background:rgba(255,255,255,.16); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,.22);
  font-size:12px; font-weight:700;
}
.booth-banner-title{font-size:28px; font-weight:800; line-height:1.35; text-shadow:0 6px 18px rgba(0,0,0,.28);}
.booth-banner-meta{font-size:13px; color:rgba(255,255,255,.88); text-shadow:0 2px 10px rgba(0,0,0,.25);}
.btn-glass{
  display:inline-flex; align-items:center; gap:6px; padding:9px 18px; border-radius:20px;
  font-size:13px; font-weight:600; color:#fff; background:rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.35); backdrop-filter:blur(6px); cursor:pointer;
}
.btn-glass:hover{background:rgba(255,255,255,.26); transform:translateY(-2px);}

.booth-headbar{
  display:flex; align-items:flex-end; gap:20px; margin:-52px 0 30px; padding:0 8px; position:relative; z-index:2;
}
.booth-id{display:flex; align-items:flex-end; gap:18px; min-width:0;}
.booth-avatar{
  width:104px; height:104px; border-radius:24px; background:var(--primary);
  border:5px solid var(--bg); color:#fff; display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-weight:400; font-size:32px; flex-shrink:0; overflow:hidden;
  box-shadow:0 10px 24px rgba(10,53,41,.3);
}
.booth-avatar img{width:100%; height:100%; object-fit:cover;}
.booth-id-text{
  padding:16px 20px; min-width:0; background:rgba(255,255,255,.96); border:1px solid rgba(226,217,199,.95);
  border-radius:18px; box-shadow:0 18px 36px rgba(10,53,41,.12);
}
.booth-id h1{font-size:24px; font-weight:800; margin-bottom:8px; line-height:1.3; color:var(--primary-dark);}
.booth-meta{display:flex; align-items:center; gap:10px; font-size:13px; color:var(--ink-soft); flex-wrap:wrap; margin-top:2px;}
.booth-meta-pill, .badge-online{
  display:inline-flex; align-items:center; gap:6px; padding:8px 12px; border-radius:999px; max-width:100%;
  white-space:normal; line-height:1.55; word-break:break-word;
}
.booth-meta-pill{background:#F7F3EA; border:1px solid var(--border); color:var(--ink-soft);}
.booth-location{background:var(--primary-tint); color:var(--primary-dark);}
.badge-online{background:var(--accent-tint); color:var(--accent); font-weight:700; font-size:11.5px; padding:8px 12px; border-radius:20px; display:inline-flex; align-items:center; gap:5px;}
.badge-online::before{content:""; width:6px; height:6px; border-radius:50%; background:var(--accent); animation:pulseDot 1.8s ease infinite;}
@keyframes pulseDot{0%,100%{opacity:1;} 50%{opacity:.35;}}

.tabs{display:flex; gap:6px; border-bottom:1px solid var(--border); margin-bottom:32px; margin-top:26px;}
.tab{padding:14px 6px; font-size:14px; font-weight:600; color:var(--ink-soft); position:relative; margin-left:26px;}
.tab:hover{color:var(--primary);}
.tab.on{color:var(--primary);}
.tab.on::after{content:""; position:absolute; right:0; left:0; bottom:-1px; height:2px; background:var(--primary);}
.trust-note{background:var(--accent-tint); border-radius:10px; padding:14px; font-size:12px; color:#7A5A1F; line-height:1.9;}
.stat-mini{display:flex; justify-content:space-between; font-size:13px; padding:9px 0; border-bottom:1px solid var(--border);}
.stat-mini:last-child{border-bottom:none;}


@media(max-width:820px){
  .booth-banner{height:230px;}
  .booth-banner-content{right:18px; left:18px; bottom:18px;}
  .booth-banner-title{font-size:22px;}
  .booth-headbar{margin:-34px 0 24px; padding:0 4px;}
  .booth-id{align-items:flex-start; gap:14px;}
  .booth-id-text{width:100%;}
}
@media(max-width:640px){
  .booth-headbar{margin:-30px 0 22px;}
  .booth-id{flex-direction:column;}
  .booth-avatar{width:84px; height:84px; border-radius:20px;}
  .booth-id-text{padding:14px 16px;}
  .booth-id h1{font-size:20px;}
}

/* ===================================================================
   پنل‌ها (ادمین / غرفه‌دار) — لایوت سایدبار تیره
   =================================================================== */
.app{display:grid; grid-template-columns:250px 1fr; min-height:100vh;}
.sidebar{background:var(--primary-dark); color:#CFE0D6; padding:26px 20px; display:flex; flex-direction:column;}
.side-logo{display:flex; align-items:center; gap:10px; color:#fff; font-size:19px; font-weight:400; margin-bottom:6px; padding:0 6px;}
.side-logo .mark{width:30px; height:30px; border-radius:8px; background:var(--accent); flex-shrink:0;}
.side-tag{font-size:11px; color:#7FA893; margin:0 6px 30px;}
.side-section{font-size:11px; color:#7FA893; font-weight:700; margin:20px 10px 10px; letter-spacing:.5px;}
.side-link{display:flex; align-items:center; gap:12px; padding:10.5px 12px; border-radius:10px; font-size:13.5px; font-weight:500; color:#CFE0D6; margin-bottom:2px; justify-content:space-between;}
.side-link .lft{display:flex; align-items:center; gap:12px;}
.side-link.on{background:rgba(255,255,255,0.1); color:#fff; font-weight:700;}
.side-count{background:var(--accent); color:#fff; font-size:10.5px; font-weight:700; padding:2px 7px; border-radius:20px;}
.side-bottom{margin-top:auto; padding-top:20px; border-top:1px solid rgba(255,255,255,0.08);}
.side-user{display:flex; align-items:center; gap:10px; padding:8px 6px;}
.side-avatar{width:36px; height:36px; border-radius:9px; background:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:700; color:#fff; font-size:13px;}
.side-user b{display:block; font-size:13px; color:#fff;}
.side-user span{font-size:11.5px; color:#7FA893;}

.main{padding:30px 36px;}
.topbar{display:flex; align-items:center; justify-content:space-between; margin-bottom:26px; flex-wrap:wrap; gap:12px;}
.topbar h1{font-size:22px; font-weight:400; color:var(--primary-dark);}
.topbar p{font-size:13px; color:var(--ink-soft); margin-top:3px;}

/* ---------- PANEL MOBILE SIDEBAR ---------- */
.panel-nav-toggle{
  display:none; align-items:center; justify-content:center; gap:8px; width:100%;
  padding:11px 16px; margin-bottom:18px; border:1px solid var(--border); border-radius:12px;
  background:var(--surface); color:var(--ink); font-family:inherit; font-size:13.5px; font-weight:700; cursor:pointer;
}
.panel-nav-toggle svg{width:17px; height:17px; stroke:var(--ink); fill:none; stroke-width:1.8; flex-shrink:0;}
.panel-scrim{display:none;}
@media(max-width:1000px){
  .panel-nav-toggle{display:flex;}
  .sidebar{
    display:flex; position:fixed; inset:0 auto 0 0; z-index:80; width:min(82vw,300px);
    transform:translateX(100%); transition:transform .32s var(--ease); box-shadow:-20px 0 44px rgba(10,53,41,.22);
  }
  html[dir="ltr"] .sidebar{ inset:0 0 0 auto; transform:translateX(-100%); box-shadow:20px 0 44px rgba(10,53,41,.22); }
  body.panel-nav-open .sidebar{transform:translateX(0);}
  .panel-scrim{
    display:block; position:fixed; inset:0; background:rgba(10,53,41,.4); z-index:75;
    opacity:0; pointer-events:none; transition:opacity .3s ease;
  }
  body.panel-nav-open .panel-scrim{opacity:1; pointer-events:auto;}
  body.panel-nav-open{overflow:hidden;}
}

.kpi-row{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:26px;}
.kpi{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px;}
.kpi-icon{width:32px; height:32px; border-radius:9px; background:var(--primary-tint); display:flex; align-items:center; justify-content:center; margin-bottom:12px; font-size:15px;}
.kpi b{display:block; font-family:var(--font-body); font-size:20px; font-weight:700; margin-bottom:2px;}
.kpi span{font-size:12px; color:var(--ink-soft);}
.kpi-trend{font-size:11.5px; font-weight:700; color:var(--green); background:var(--green-tint); padding:3px 9px; border-radius:20px;}

.panel{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px;}
.panel-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:18px;}
.panel-head h3{font-size:15px; font-weight:700;}
.panel-head .link{font-size:12.5px; color:var(--primary); font-weight:600;}
.grid-2{display:grid; grid-template-columns:1.4fr 1fr; gap:20px; margin-bottom:26px;}

.table-wrap{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow-x:auto; -webkit-overflow-scrolling:touch; margin-bottom:26px;}
table{width:100%; border-collapse:collapse; min-width:560px;}
thead th{text-align:right; font-size:11.5px; font-weight:700; color:var(--ink-soft); padding:14px 20px; background:var(--primary-tint); border-bottom:1px solid var(--border);}
tbody td{padding:14px 20px; font-size:13px; border-bottom:1px solid var(--border);}
tbody tr:last-child td{border-bottom:none;}
.cell-booth, .prod-cell{display:flex; align-items:center; gap:10px;}
.status-pill{font-size:11px; font-weight:700; padding:4px 11px; border-radius:20px; display:inline-block;}
.status-pill.pending, .status-pill.new{background:var(--accent-tint); color:var(--accent);}
.status-pill.paid, .status-pill.done, .status-pill.delivered{background:var(--green-tint); color:var(--green);}
.status-pill.shipped, .status-pill.processing{background:var(--blue-tint); color:var(--blue);}
.status-pill.rejected, .status-pill.cancelled, .status-pill.failed{background:var(--red-tint); color:var(--red);}
.row-actions{color:var(--primary); font-weight:600; font-size:12.5px; cursor:pointer;}

.approve-item{display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--border);}
.approve-item:last-child{border-bottom:none;}
.approve-info{flex:1;}
.approve-info b{display:block; font-size:13.5px;}
.approve-info span{font-size:12px; color:var(--ink-soft);}
.approve-actions{display:flex; gap:6px;}
.icon-btn{width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; border:1px solid var(--border); background:var(--surface); cursor:pointer; font-size:14px;}
.icon-btn.approve{color:var(--green); border-color:#CDE7D6;}
.icon-btn.reject{color:var(--red); border-color:#EBC9C2;}

.tree-item{display:flex; align-items:center; justify-content:space-between; padding:10px 0; font-size:13.5px;}
.tree-sub{padding-right:22px; border-right:2px solid var(--border); margin-right:8px;}
.tree-sub .tree-item{padding:7px 0; font-size:13px; color:var(--ink-soft);}
.tree-count{font-size:11.5px; color:var(--ink-soft);}

.pay-btn{background:var(--primary); color:#fff; border:none; padding:7px 14px; border-radius:8px; font-family:inherit; font-size:12px; font-weight:600; cursor:pointer;}

/* form field group used in vendor product form / checkout */
.field-group{margin-bottom:16px;}
.field-group label{display:block; font-size:13px; font-weight:600; margin-bottom:7px; color:var(--ink);}
.form-grid-2{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
@media(max-width:560px){
  .form-grid-2{grid-template-columns:1fr; gap:0;}
}

/* empty state */
.empty-state{text-align:center; padding:60px 20px; color:var(--ink-soft);}
.empty-state .icon{font-size:34px; margin-bottom:14px;}

@media(max-width:1000px){
  .app{grid-template-columns:1fr;}
  .kpi-row{grid-template-columns:repeat(2,1fr);}
  .grid-2, .layout{grid-template-columns:1fr;}
  .booth-grid, .prod-grid, .cat-rail{grid-template-columns:repeat(3,1fr);}
}
@media(max-width:760px){
  .booth-grid, .prod-grid, .cat-rail{grid-template-columns:repeat(2,1fr);}
  .main{padding:24px 20px;}
}
@media(max-width:480px){
  .booth-grid, .prod-grid{grid-template-columns:1fr;}
  .cat-rail{grid-template-columns:repeat(2,1fr);}
  .kpi-row{grid-template-columns:1fr;}
  .main{padding:18px 14px;}
  .section{padding:44px 0;}
  .section-head{flex-direction:column; align-items:flex-start; gap:8px;}
}

/* نوار پیشرفت بالای صفحه موقع ناوبری Turbo — هماهنگ با رنگ برند به‌جای آبی پیش‌فرض */
.turbo-progress-bar{background-color:var(--accent); height:3px;}

/* ===================================================================
   ورود نرم صفحات و کارت‌ها — هر بار که Turbo محتوای تازه می‌آره این
   انیمیشن‌ها خودشون دوباره اجرا می‌شن چون المان‌ها واقعاً تازه ساخته می‌شن.
   =================================================================== */
@keyframes fadeInUp{
  from{opacity:0; transform:translateY(16px);}
  to{opacity:1; transform:translateY(0);}
}
@keyframes fadeIn{
  from{opacity:0;}
  to{opacity:1;}
}
.hero, .section, .booth-headbar, .crumb + .section-head, .layout{
  animation:fadeInUp .55s var(--ease) both;
}
.booth-grid > a, .prod-grid > a, .cat-rail > a{
  animation:fadeInUp .5s var(--ease) both;
}
.booth-grid > a:nth-child(1), .prod-grid > a:nth-child(1), .cat-rail > a:nth-child(1){animation-delay:.02s;}
.booth-grid > a:nth-child(2), .prod-grid > a:nth-child(2), .cat-rail > a:nth-child(2){animation-delay:.07s;}
.booth-grid > a:nth-child(3), .prod-grid > a:nth-child(3), .cat-rail > a:nth-child(3){animation-delay:.12s;}
.booth-grid > a:nth-child(4), .prod-grid > a:nth-child(4), .cat-rail > a:nth-child(4){animation-delay:.17s;}
.booth-grid > a:nth-child(5), .prod-grid > a:nth-child(5), .cat-rail > a:nth-child(5){animation-delay:.22s;}
.booth-grid > a:nth-child(6), .prod-grid > a:nth-child(6), .cat-rail > a:nth-child(6){animation-delay:.27s;}
.booth-grid > a:nth-child(n+7), .prod-grid > a:nth-child(n+7), .cat-rail > a:nth-child(n+7){animation-delay:.3s;}
.alert{animation:fadeInUp .4s var(--ease) both;}

@media(prefers-reduced-motion: reduce){
  *, *::before, *::after{animation-duration:.001s !important; animation-iteration-count:1 !important; transition-duration:.001s !important; scroll-behavior:auto !important;}
}

.product-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
.enhanced-grid .product-card-advanced{
  background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.94)); border:1px solid var(--border); border-radius:22px; overflow:hidden; color:var(--ink); display:flex; flex-direction:column; position:relative; box-shadow:0 14px 34px rgba(10,53,41,.06);
}
.product-card-advanced::before{
  content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(192,138,46,.05), transparent 38%); opacity:0; transition:opacity .25s ease;
}
.product-card-media{position:relative; height:220px; overflow:hidden; background:var(--primary-tint);}
.product-card-media img{width:100%; height:100%; object-fit:cover; transition:transform .7s var(--ease), filter .3s ease;}
.product-card-content{position:relative; z-index:1; padding:16px 16px 18px; display:flex; flex-direction:column; gap:8px; height:100%;}
.product-booth-name{display:inline-flex; align-self:flex-start; padding:5px 10px; border-radius:999px; background:#f7f3ea; border:1px solid var(--border); color:var(--primary); font-size:11.5px; font-weight:700;}
.product-card-content b{font-size:16px; font-weight:700; color:var(--primary-dark); line-height:1.5;}
.product-card-content small{color:var(--ink-soft); font-size:12px;}
.product-price-stack{display:flex; flex-direction:column; gap:3px; margin-top:auto;}
.product-price-stack del{font-size:12px; color:#a58f6d;}
.product-price-stack strong{font-size:18px; color:var(--accent);}
.product-card-cta{display:inline-flex; align-items:center; gap:8px; margin-top:8px; color:var(--primary); font-weight:700; font-size:13px;}
.product-card-cta::after{content:"←"; transition:transform .25s var(--ease);} 
.discount-badge, .product-chip{position:absolute; top:14px; left:14px; z-index:2; padding:7px 12px; border-radius:999px; color:#fff; font-size:11px; font-weight:800; box-shadow:0 10px 20px rgba(10,53,41,.12);}
.discount-badge{background:linear-gradient(135deg, var(--accent), #d39d43);} 
.product-chip{background:rgba(10,53,41,.78); backdrop-filter:blur(4px);} 
.product-card-advanced:hover{transform:translateY(-8px); box-shadow:0 24px 44px rgba(10,53,41,.14); border-color:#cdb98a;}
.product-card-advanced:hover::before{opacity:1;}
.product-card-advanced:hover .product-card-media img{transform:scale(1.08); filter:saturate(1.06);} 
.product-card-advanced:hover .product-card-cta::after{transform:translateX(-4px);} 
.product-showcase .section-head{margin-bottom:26px;}
.special-showcase .section-head > div, .curated-showcase .section-head > div{position:relative;}
.special-showcase .section-head > div::after, .curated-showcase .section-head > div::after{content:""; position:absolute; right:0; bottom:-8px; width:84px; height:3px; border-radius:3px; background:linear-gradient(90deg, var(--accent), transparent);} 
.hero{position:relative}
.booth-media{height:220px}
.media-img{object-fit:cover;width:100%;height:100%}
.cta-panel{background:linear-gradient(135deg, var(--primary), var(--primary-dark)); border-radius:24px; padding:52px 56px; display:flex; align-items:center; justify-content:space-between; gap:40px; color:#fff; flex-wrap:wrap; box-shadow:0 20px 40px rgba(10,53,41,.16);}
.cta-panel h2{font-size:26px; font-weight:800; margin-bottom:10px;}
.cta-panel p{font-size:14.5px; color:#CFE0D6; max-width:440px;}
@media(max-width:1100px){
  .hero-shell{grid-template-columns:1fr;}
  .hero-visual{min-height:auto; padding-bottom:28px;}
  .product-grid{grid-template-columns:repeat(3,1fr);}
}
@media(max-width:900px){
  .product-grid{grid-template-columns:repeat(2,1fr)}
  .hero-mini-stats, .hero-stats-grid{grid-template-columns:1fr;}
  .hero-mosaic{grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(4,120px);}
  .hero-tile-1{grid-column:1/3; grid-row:1/3;}
  .hero-tile-2{grid-column:1/2; grid-row:3/4;}
  .hero-tile-3{grid-column:2/3; grid-row:3/5;}
  .hero-tile-4{grid-column:1/2; grid-row:4/5;}
  .hero-tile-5{grid-column:1/2; grid-row:4/5; display:none;}
  .hero-floating-card{position:relative; left:auto; bottom:auto; margin-top:14px; max-width:none;}
}
@media(max-width:680px){
  .hero-home{padding-top:22px;}
  .hero-copy{padding:24px 18px; border-radius:24px;}
  .hero-copy h1{font-size:30px;}
  .hero-search{flex-direction:column; align-items:stretch;}
  .hero-search button{width:100%;}
  .hero-mosaic{grid-template-columns:1fr; grid-template-rows:none;}
  .hero-tile, .hero-tile-1, .hero-tile-2, .hero-tile-3, .hero-tile-4{grid-column:auto !important; grid-row:auto !important; min-height:180px;}
  .hero-tile-5{display:block;}
  .product-grid{grid-template-columns:1fr}
  .cta-panel{padding:32px 24px;}
}
@media(max-width:560px){
  .hero .wrap{display:block!important}
  .hero h1{font-size:30px!important}
  .booth-meta-pill, .badge-online{width:100%; justify-content:center;}
  .booth-banner-content{align-items:flex-start;}
}

/* ---------- MODAL OVERLAY ---------- */
.modal-overlay{position:fixed; inset:0; background:rgba(0,0,0,0.55); backdrop-filter:blur(6px); z-index:1000; display:none; align-items:center; justify-content:center; padding:32px; opacity:0; transition:opacity 0.25s ease;}
.modal-overlay.active{display:flex; opacity:1;}
.modal-box{background:var(--surface); border-radius:20px; max-width:900px; width:100%; max-height:90vh; overflow-y:auto; position:relative; box-shadow:0 12px 40px rgba(0,0,0,0.10); animation:modalIn 0.3s ease;}
@keyframes modalIn{from{transform:translateY(20px) scale(0.97); opacity:0;}to{transform:translateY(0) scale(1); opacity:1;}}
.modal-close{position:absolute; top:16px; right:16px; width:36px; height:36px; border-radius:50%; background:var(--bg); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:10; font-size:18px; color:var(--ink-soft); transition:all var(--transition);}
.modal-close:hover{background:var(--red-tint); color:var(--red); border-color:var(--red);}
.modal-gallery{display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:20px;}
.modal-gallery-thumb{width:100%; aspect-ratio:1; border-radius:10px; overflow:hidden; cursor:pointer; border:2px solid transparent; transition:all var(--transition);}
.modal-gallery-thumb img{width:100%; height:100%; object-fit:cover;}
.modal-gallery-thumb.active{border-color:var(--primary);}
.modal-gallery-thumb:hover{border-color:var(--accent);}
.modal-main-img{width:100%; aspect-ratio:4/3; border-radius:14px; overflow:hidden; margin-bottom:20px; background:var(--primary-tint);}
.modal-main-img img{width:100%; height:100%; object-fit:cover;}
.modal-info h2{font-size:22px; font-weight:800; margin-bottom:8px; letter-spacing:-0.2px;}
.modal-info .modal-price{font-size:24px; font-weight:800; color:var(--primary-dark); margin-bottom:12px;}
.modal-info .modal-desc{font-size:14px; color:var(--ink); line-height:1.8; margin:16px 0; padding-top:16px; border-top:1px solid var(--border);}
.modal-actions{display:flex; gap:12px; margin-top:20px; align-items:center;}
.modal-qty{display:flex; align-items:center; border:1px solid var(--border); border-radius:var(--radius-sm); overflow:hidden;}
.modal-qty button{width:36px; height:36px; border:none; background:var(--bg); cursor:pointer; font-size:16px; font-weight:700; color:var(--ink); transition:background var(--transition);}
.modal-qty button:hover{background:var(--primary-tint);}
.modal-qty input{width:48px; height:36px; border:none; border-left:1px solid var(--border); border-right:1px solid var(--border); text-align:center; font-family:inherit; font-size:14px; font-weight:600; background:var(--surface); color:var(--ink); outline:none;}
.modal-actions .btn{flex:1;}

/* ---------- PRODUCT DETAIL ---------- */
.product-detail-grid{display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:start; padding:30px 0 70px;}
.product-detail-gallery{position:sticky; top:84px;}
.gallery-main{width:100%; aspect-ratio:3/4; border-radius:var(--radius); overflow:hidden; background:var(--primary-tint); margin-bottom:12px;}
.gallery-main img{width:100%; height:100%; object-fit:cover;}
.gallery-thumbs{display:flex; gap:10px; overflow-x:auto;}
.gallery-thumb{width:72px; height:72px; border-radius:10px; overflow:hidden; cursor:pointer; border:2px solid transparent; transition:all 0.2s; flex-shrink:0;}
.gallery-thumb:hover,.gallery-thumb.active{border-color:var(--primary);}
.gallery-thumb img{width:100%; height:100%; object-fit:cover;}
.product-detail-info h1{font-size:26px; font-weight:800; letter-spacing:-0.3px;}

@media(max-width:1000px){
  .product-detail-grid{grid-template-columns:1fr; gap:28px; padding:24px 0 50px;}
}
@media(max-width:480px){
  .gallery-thumb{width:56px; height:56px;}
}

